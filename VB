#If VBA7 Then
    ' 64-bit Windows API declarations
    Private Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal dwMilliseconds As Long)
    Private Declare PtrSafe Sub mouse_event Lib "user32" (ByVal dwFlags As Long, ByVal dx As Long, ByVal dy As Long, ByVal cButtons As Long, ByVal dwExtraInfo As Long)
#Else
    ' 32-bit Windows API declarations
    Private Declare Sub Sleep Lib "kernel32" (ByVal dwMilliseconds As Long)
    Private Declare Sub mouse_event Lib "user32" (ByVal dwFlags As Long, ByVal dx As Long, ByVal dy As Long, ByVal cButtons As Long, ByVal dwExtraInfo As Long)
#End If

' Windows Constants for Mouse Clicks
Private Const MOUSEEVENTF_LEFTDOWN As Long = &H2
Private Const MOUSEEVENTF_LEFTUP As Long = &H4

Dim IsRunning As Boolean

' START THE CLICKER
Sub StartClicker()
    If IsRunning Then
        MsgBox "Clicker is already running!", vbInformation
        Exit Sub
    End If
    
    IsRunning = True
    
    Do While IsRunning
        ' 1. Simulate a Left Mouse Click (Down then Up) at current position
        Call mouse_event(MOUSEEVENTF_LEFTDOWN, 0, 0, 0, 0)
        Call mouse_event(MOUSEEVENTF_LEFTUP, 0, 0, 0, 0)
        
        ' 2. Wait for 3 minutes (180 seconds)
        Dim i As Long
        For i = 1 To 180
            If Not IsRunning Then Exit Do
            Sleep 1000 ' Sleep 1 second
            DoEvents   ' Prevents Excel from freezing, allowing you to stop it
        Next i
    Loop
End Sub

' STOP THE CLICKER
Sub StopClicker()
    IsRunning = False
    MsgBox "Mouse Clicker stopped.", vbInformation
End Sub
