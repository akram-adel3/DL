#If VBA7 Then
    ' 64-bit Windows API declarations
    Private Declare PtrSafe Sub Sleep Lib "kernel32" (ByVal dwMilliseconds As Long)
    Private Declare PtrSafe Function GetCursorPos Lib "user32" (ByRef lpPoint As POINTAPI) As Long
    Private Declare PtrSafe Function SetCursorPos Lib "user32" (ByVal x As Long, ByVal y As Long) As Long
#Else
    ' 32-bit Windows API declarations
    Private Declare Sub Sleep Lib "kernel32" (ByVal dwMilliseconds As Long)
    Private Declare Function GetCursorPos Lib "user32" (ByRef lpPoint As POINTAPI) As Long
    Private Declare Function SetCursorPos Lib "user32" (ByVal x As Long, ByVal y As Long) As Long
#End If

Private Type POINTAPI
    x As Long
    y As Long
End Type

Dim IsRunning As Boolean

' START THE JIGGLER
Sub StartJiggler()
    Dim HoldPos As POINTAPI
    Dim Toggle As Boolean
    
    If IsRunning Then
        MsgBox "Jiggler is already running!", vbInformation
        Exit Sub
    End If
    
    IsRunning = True
    Toggle = True
    
    Do While IsRunning
        ' 1. Get the current physical mouse position
        Call GetCursorPos(HoldPos)
        
        ' 2. Nudge the mouse by 1 pixel back and forth
        If Toggle Then
            Call SetCursorPos(HoldPos.x + 1, HoldPos.y)
        Else
            Call SetCursorPos(HoldPos.x - 1, HoldPos.y)
        End If
        
        Toggle = Not Toggle
        
        ' 3. Wait for 3 minutes (180,000 milliseconds)
        ' Allows Excel to remain responsive during the wait
        Dim i As Long
        For i = 1 To 180
            If Not IsRunning Then Exit Do
            Sleep 1000 ' Sleep 1 second
            DoEvents   ' Yield control to Windows so Excel doesn't freeze
        Next i
    Loop
End Sub

' STOP THE JIGGLER
Sub StopJiggler()
    IsRunning = False
    MsgBox "Mouse Jiggler stopped.", vbInformation
End Sub
